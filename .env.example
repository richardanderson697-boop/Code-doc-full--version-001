# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APP_ACCESS_TOKEN: Optional. Leave unset inside AI Studio. When self-hosting
# on a public URL, set it to a long random value and every /api route will
# require "Authorization: Bearer <token>". Protects your Gemini quota.
# APP_ACCESS_TOKEN="generate-a-long-random-string"

# PORT: Optional. Injected by Cloud Run and most hosts; defaults to 3000 locally.
# PORT=3000

# ---- Auth + credit packs (SaaS mode) ----
# GEMINI_API_KEY above is now YOUR key, held server-side. Users buy credit
# packs; each AI call meters tokens and deducts credits (1 credit = $0.01).

# STRIPE_SECRET_KEY: server-side Stripe key (sk_test_... for test mode,
# sk_live_... for real payments). Never expose to the client.
# STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET: from Stripe Dashboard > Developers > Webhooks,
# signing secret (whsec_...) for the /api/billing/webhook endpoint.
# STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs for the credit packs (test-mode IDs created 2026-09-22).
# Replace with live-mode price IDs when launching real payments.
PRICE_STARTER=price_1UIfaVBTjCAw9GBp67uzEbJZ
PRICE_BUILDER=price_1UIfb1BTjCAw9GBpasTmjIL6
PRICE_PRO=price_1UIfb4BTjCAw9GBpsN5RQOv2

# WELCOME_CREDITS: free credits granted on signup (default 50).
# WELCOME_CREDITS=25
